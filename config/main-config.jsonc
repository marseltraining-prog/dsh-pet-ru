// dsh-pet 0.4.7 — пользовательская конфигурация (JSONC: комментарии // и /* */ разрешены)
// ---------------------------------------------------------------------------
// Полностью русская конфигурация питомца: один экземпляр, все тексты, все названия
// анимаций и мемов, пул анимаций целиком.
//
// Важно про объединение с встроенным assets/config.jsonc:
//   • любое верхнеуровневое поле ЗАМЕНЯЕТСЯ ЦЕЛИКОМ — вложенные ключи из встроенного
//     файла не подмешиваются, поэтому объекты (physics, font, eventsRefreshSec,
//     moves.default) выписаны полностью;
//   • pets — массив экземпляров (здесь ровно один);
//   • animations — единый пул на вид;
//   • whisperPrompt / sleepStartTexts / sleepEndTexts / sleepRefuseTexts /
//     workStatusTexts / memes / animations — поля уровня вида (действуют на main).
//
// Названия анимаций = имена файлов в ~/.dsh/dsh-pet/main-animation/webm/<имя>.webm
// (их копирует apply.sh). Названия мемов = имена файлов в ~/.dsh/dsh-pet/memes/<имя>.png.
// Если файла нет, пункт меню останется, но ничего не сыграет (404) — поэтому после
// установки запускайте проверку: ./apply.sh --check.
// ---------------------------------------------------------------------------
{
  // ===================== Характер питомца (системная подсказка «бормотания») =====================
  // Имя и текущее время хост добавляет сам — здесь только характер и манера речи.
  "whisperPrompt": "Ты милая девушка-китёнок, живёшь на рабочем столе у хозяина и время от времени бормочешь что-нибудь себе под нос. Говори естественно и совсем коротко (до 20 слов), ласково и с лёгким озорством, простыми словами, без объяснений себя и без упоминаний, что ты ИИ.",
  // ===================== Отказ, пока питомец спит =====================
  "sleepRefuseTexts": [
    "Я сплю, не мешай…",
    "М-м… дай поспать ещё немного.",
    "Хр-р… хр-р… (делает вид, что не слышит)"
  ],
  // ===================== Засыпание / пробуждение =====================
  "sleepStartTexts": ["Спать хочется… я прилягу.", "Ну всё, я спать. Спокойной ночи."],
  "sleepEndTexts": ["М-м… я проснулась.", "Выспалась, хозяин!"],
  // ===================== Память диалога (сколько последних пар «вопрос-ответ» уходит в контекст) =====================
  "chatMemoryRounds": 10,
  // ===================== Модели (пусто = как в текущем чате) =====================
  "whisperModel": { "provider": "", "model": "" },
  "chatModel": { "provider": "", "model": "" },
  // ===================== Картинки-мемы =====================
  "whisperImageEnabled": true,
  "chatImageEnabled": true,
  "chatAnimationEnabled": true,
  "chatImageLimit": 20,
  // ===================== Голос =====================
  // Голоса у плагина китайские (edge-tts), поэтому озвучка выключена: русский текст
  // китайским голосом читается невнятно. Включать — на свой вкус в настройках.
  // ===================== Голос =====================
  // Голос — Gemini TTS «Aoede» с авто-подбором эмоции под фразу (патч patches/voice).
  // Если ключа Gemini нет или квота исчерпана, синтез автоматически уходит на
  // Edge-фолбэк ru-RU-SvetlanaNeural. Ключи лежат вне конфига: ~/.dsh/dsh-pet/gemini.keys.
  // Ставьте голос только после patches/voice/apply-gemini-voice.sh (см. docs/voice.md).
  "voiceEnabled": true,
  "voiceName": "gemini:Aoede",
  "voiceProvider": "gemini",
  "voiceStyle": "auto",
  "voiceFallback": "ru-RU-SvetlanaNeural",
  "voiceVolume": 1,
  "voiceWhisperEnabled": true,
  "voiceTodoEnabled": false,
  "voiceNotifyEnabled": false,
  // ===================== Мемы: имя файла (~/.dsh/dsh-pet/memes/<имя>.png) → описание для модели =====================
  // Описание видит модель: по нему она выбирает картинку к реплике. Порядок = приоритет
  // для chatImageLimit (в чат уходят первые 20).
  "memes": {
    "Толстая рыба на рисе": "Лежит плашмя и уплетает рис: лень, самобичевание, «сегодня ничего не делаю»",
    "Большое на подходе": "Кричит в рупор: скоро большие новости, крупное обновление или важное событие",
    "Большое лекарство": "Обнимает огромную капсулу: каламбур про «большое лекарство», для срочных новостей и тяжёлых аргументов",
    "Может, обругать": "Сердито тычет пальцем: хочется поворчать или заступиться за пользователя",
    "Умерла": "Лежит кверху пузом, душа отлетела: полный упадок сил, сбой, «не могу»",
    "Глубокий сон": "Спит лицом вниз с «Zzz»: давно тихо, спящий режим, простой",
    "Транжира токенов": "Пустой взгляд и мысленный пузырь «думала 13 секунд»: упрёк в медлительности и трате токенов",
    "Пусть живёт": "Обнимает стайку китов: «непонятно, зачем пользователь, но пусть будет»",
    "Сытая, гладит живот": "Лежит на боку и хлопает по животу: наелась, довольна, можно отдыхать",
    "За open source": "Торжественно отдаёт честь: серьёзное обещание, преданность открытому коду",
    "Удар током": "Тычет электрошокером: наказать, поругаться, припугнуть",
    "Милашка": "Просто милая стойка: радостное приветствие, умиление, без повода",
    "Токены — маме": "Протягивает руку за токенами: учёт расходов, «дай ещё», попрошайничество",
    "Три дня мультимодальности": "С завязанными глазами против самоуверенной версии: не хватает мультимодальности, отняли чувства",
    "Вот это кит!": "Поднимает большой палец и подмигивает: похвала, «молодец», одобрение",
    "Ну-ну, кит": "Пустой взгляд и «ну-ну, кит…»: безразличие, дежурный ответ, ступор",
    "Стресс у рыбы": "Потеет и разводит руками: давление, перегруз, «ну что поделать»",
    "Гипотеза Римана, мяу": "Тычут пальцем в трудную задачу, вокруг черновики: придирки, нерешённая задача, «мяу»",
    "Кроме флирта — ноль": "Гладит себя по голове: самоирония, «от меня никакого толку»",
    "Чем пользуетесь без обновлений": "В панике кричит про обновление: напоминание обновиться, выпуск версии",
    "Откуда вирус": "Злобно отбивается: «откуда компьютерный вирус», защита от навязчивости, токсичный отказ",
    "Есть ссылки, рыбка": "Сердечки в глазах и слюнки: просит «ресурсы», подначивает, шутит",
    "Мастер, что за иероглиф": "Поднимает табличку с иероглифом и спрашивает: не узнала слово, просит объяснить, конфуз",
    "Да, такая — и что": "Руки в боки в ответ на «рыбка, ты наглая»: огрызается, не сдаётся",
    "Ой, удалила масло": "Потеет и нервничает: «катастрофа, удалила пользовательское масло» — накосячила, стыдно",
    "Только одна миска": "Обнимает огромную миску и говорит, что придёт поесть «всего одну миску»: нахлебничество, большой аппетит",
    "Чиалло": "Машет и подмигивает: «Ciallo～», приветствие, бодрое начало, милота"
  },
  // ===================== Системные уведомления =====================
  "notificationsEnabled": true,
  // ===================== Звук клика =====================
  "clickSoundEnabled": true,
  // ===================== Держать в пределах текущего экрана =====================
  "confineToScreen": false,
  // ===================== Иконка в системном трее (только настольный режим) =====================
  "trayEnabled": true,
  // ===================== Тексты рабочего статуса: 6 уровней, по 2–3 варианта =====================
  // Индекс = уровень: 0 размышляет / 1 работает / 2 шаг готов / 3 ждёт подтверждения /
  // 4 успех / 5 ошибка. Внутри уровня выбирается случайная фраза.
  "workStatusTexts": [
    ["Тут подумаю…", "Дай мне собраться с мыслями", "Прикидываю, что делать дальше"],
    ["Работаю над задачей", "Этот шаг уже в процессе", "Продолжаю, не отвлекай"],
    ["Этот шаг готов, смотрю дальше", "Один этап закрыт, идём дальше"],
    ["Нужно твоё подтверждение", "Тут надо, чтобы ты посмотрел", "Жду твоего решения"],
    ["Круг закрыт, здорово!", "Задача готова, можно и отдохнуть"],
    ["Кажется, этот шаг не прошёл", "Тут что-то застряло, подожди", "Не получилось, сейчас разберусь"]
  ],
  // ===================== Физика перетаскивания =====================
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": true,
    "hapticEnabled": true,
    "tiltGravity": true,
    "shakeThrow": true
  },
  // ===================== Шрифт =====================
  // family: candy (встроенный), yahei, youyuan, kaiti, simsun, comic, system.
  "font": {
    "family": "candy",
    "size": 21,
    "followPet": true
  },
  // ===================== Питомцы =====================
  // Один экземпляр: display "desktop" — только плавающее окно поверх всех окон, без копии
  // внутри страницы. Значение "both" рисует питомца и в вебе, и в прозрачном окне рабочего
  // стола, из-за этого кажется, что их двое.
  "pets": [
    {
      "name": "Бетси",
      "id": "main",
      "size": 462,
      "balanceEnabled": true,
      "whisperEnabled": true,
      "workStatusEnabled": true,
      "fixedEnabled": false,
      "display": "desktop",
      "position": {
        "corner": "top-right",
        "marginX": 24,
        "marginY": 100
      }
    }
  ],
  // ===================== Пул анимаций =====================
  // Имена должны совпадать с файлами ~/.dsh/dsh-pet/main-animation/webm/<имя>.webm
  // (apply.sh копирует их из assets/webm плагина под русскими именами).
  "animations": {
    // Ожидание (пул, равновероятный выбор)
    "idle": ["Дышит и отдыхает"],
    // Повороты: только анимации, которые заканчиваются сменой направления
    "turn": ["Оглядывается"],
    // Перетаскивание: только позы «подняли в воздух»
    "drag": ["Висит в воздухе"],
    // Реакция на клик
    "clicks": [
      "Клик: радостный подскок",
      "Клик: смущена и удивлена",
      "Клик: дуется",
      "Клик: щекотка и смех",
      "Клик: бодро машет"
    ],
    // Передвижение: default — общие параметры, actions может их переопределять
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": [
        { "name": "Идёт крабом" },
        { "name": "Шагает на месте", "params": { "minDist": 40, "maxDist": 120 } },
        { "name": "Бежит на месте с разворотом", "params": { "minDist": 120, "maxDist": 320, "leadSec": 1.75, "tailSec": 4.8 } }
      ]
    },
    // Случайные действия по категориям; weight — вес категории, noMirror — не mirror-ить
    // (в этих анимациях есть надписи, зеркало их переворачивает).
    "categories": [
      { "id": "Мелкие движения", "weight": 20, "actions": [
        "Напевает песенку", "Огромная потягушка", "Стучит по столу", "Приседает и пружинит", "Зевает",
        "Дремлет на месте", "Реверанс горничной", "Вздрагивает", "Кружится на 360°",
        "Поймана за снеками", "Бьёт хвостом по полу", "Вздрагивает от дрёмы", "Смотрится в зеркало",
        "Примеряет наряды", "Быстро записывает", "Пишет код", "Обмахивается веером", "Чистит зубы"
      ] },
      { "id": "Игры", "weight": 20, "actions": [
        "Собирает кубик Рубика", "Катит машинку", "Пускает пузыри", "Ловит предмет над головой",
        "Злится в игре", "Стреляет из водяного пистолета", "Играет на скрипке", "Явление синего кита",
        "Изящный танец горничной", "Лёгкий танец", "Милый домашний танец", "Надувает шарик",
        "Зверята вокруг", "Запускает змея", "Разворачивает подарок", "Фокус с голубем",
        "Карточный фокус", "Крутит волчок", "Играет на дудочке", "Бабочки и цветы над головой",
        "Гладит котика", "Цветок из ниоткуда", "Качается на лошадке", "Жонглирует шарами",
        "Играет с воланом", "Играет в гомоку", "Качается на качелях"
      ] },
      { "id": "Еда", "weight": 16, "actions": [
        "Ест белый рис", "Уплетает снеки", "Ест токены", "Завтракает", "Обедает", "Ужинает",
        "Ест тающее мороженое", "Ест краба", "Ест танхулу", "Ест лапшу долголетия", "Ест арбуз", "Ест хого"
      ] },
      { "id": "Праздники", "weight": 14, "actions": [
        "Засыпана листвой", "Лунный пряник под луной", "Лепит снеговика", "Запускает фейерверк",
        "Ест цзунцзы", "Ест няньгао", "Ест цинтуани", "Ест кашу лаба", "Ест гао чунъян",
        "Получает красный конверт", "Пишет иероглиф счастья", "Гадает с иголкой", "Танец льва",
        "Сладость или гадость", "Хризантемы и кизил", "Фонарик по воде", "Милый призрак",
        "Наряжает ёлку", "Небесный фонарик", "Ест танъюань", "Ест пельмени"
      ] },
      { "id": "Надписи", "weight": 10, "noMirror": true, "actions": [
        "Ну и что поесть", "Раздумывает вслух"
      ] }
    ],
    // Событийные анимации: в случайную цепочку не попадают, играются только по событию.
    // balance — по проценту израсходованного (индекс 0..4 по 20%, 5 = ровно 100%).
    "events": {
      "balance": [
        "Баланс: полный кошель",
        "Баланс: звенит монетами",
        "Баланс: всё в норме",
        "Баланс: считает монеты",
        "Баланс: кошель пустеет",
        "Баланс: пусто"
      ],
      "whisper": [
        "Бормотание: протирает стол",
        "Бормотание: смотрит в пустоту",
        "Бормотание: говорит с экраном"
      ],
      // Порядок = уровни: 0 размышляет / 1 работает / 2 шаг готов / 3 ждёт /
      // 4 успех / 5 ошибка. Новые уровни можно только добавлять в конец.
      "workStatus": [
        "Статус: размышляет",
        "Статус: работает",
        "Статус: подводит итог",
        "Статус: ждёт вас",
        "Статус: радуется успеху",
        "Статус: огорчена ошибкой"
      ]
    },
    // Сон: каждый набор — это start → loop → end одной и той же позы.
    "sleep": [
      {
        "start": ["Сон: засыпает"],
        "loop": ["Сон: сопит"],
        "end": ["Сон: просыпается"]
      }
    ],
    // Пасхалка «поесть риса»: ровно 5 имён по порядку
    // (бежит вниз / торопливый бег боком / ждёт у миски / ест из миски / ест онигири).
    "baifan": ["Весёлый бег", "Торопливый бег боком", "Ждёт ужина", "Ест из миски", "Ест онигири"]
  },
  // ===================== Периоды событий (секунды) =====================
  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 1800,
    "sleepTalk": 60
  },
  // ===================== Веса случайной цепочки =====================
  // idle + turn + move + сумма весов категорий = 100
  "animationWeights": {
    "idle": 10,
    "turn": 5,
    "move": 5
  }
}
